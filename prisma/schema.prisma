generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

// Supabase owns this table. Prisma config excludes it from migrations.
model AuthUser {
  id             String               @id @db.Uuid
  profile        Profile?
  feedback       Feedback[]
  ownedTracks    UserOwnedTrack[]
  favoriteSeries UserFavoriteSeries[]
  @@map("users")
  @@schema("auth")
}

model Profile {
  id        String   @id @db.Uuid
  email     String?
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  user      AuthUser @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "profiles_id_fkey")
  @@map("profiles")
  @@schema("public")
}

model Feedback {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  name      String?
  message   String
  pagePath  String?   @map("page_path")
  createdAt DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  user      AuthUser? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "feedback_user_id_fkey")
  @@map("feedback")
  @@schema("public")
}

model UserOwnedTrack {
  userId    String   @map("user_id") @db.Uuid
  trackId   Int      @map("track_id")
  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_owned_tracks_user_id_fkey")
  @@id([userId, trackId])
  @@map("user_owned_tracks")
  @@schema("public")
}

model UserFavoriteSeries {
  userId    String   @map("user_id") @db.Uuid
  seriesName String  @map("series_name")
  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_favorite_series_user_id_fkey")
  @@id([userId, seriesName])
  @@map("user_favorite_series")
  @@schema("public")
}

model Season {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  name         String
  year         Int
  seasonNumber Int      @map("season_number")
  isCurrent    Boolean  @default(false) @map("is_current")
  series       Series[]

  @@unique([year, seasonNumber])
  @@map("seasons")
  @@schema("public")
}

model Series {
  id       Int          @id @default(autoincrement())
  seasonId Int          @map("season_id")
  name     String
  category String
  linkedTo Int?         @map("linked_to")
  season   Season       @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // Custom migration SQL clears only linked_to, preserving required season_id.
  linked   Series?      @relation("SeriesVariants", fields: [seasonId, linkedTo], references: [seasonId, id], onDelete: SetNull, onUpdate: NoAction)
  variants Series[]     @relation("SeriesVariants")
  weeks    SeriesWeek[]

  @@unique([seasonId, name])
  @@unique([seasonId, id])
  @@index([seasonId, linkedTo])
  @@map("series")
  @@schema("public")
}

model SeriesWeek {
  seriesId   Int      @map("series_id")
  weekNumber Int      @map("week_number")
  trackId    Int      @map("track_id")
  trackName  String   @map("track_name")
  raceDate   DateTime @map("race_date") @db.Date
  series     Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([seriesId, weekNumber])
  @@index([trackId])
  @@map("series_weeks")
  @@schema("public")
}
