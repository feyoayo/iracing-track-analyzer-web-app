# Browser-safe Supabase Auth settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for public schedules too. Runtime role must SET ROLE anon/authenticated.
DATABASE_URL=
# Direct/session administrator connection for migrations/imports, never browser-exposed.
DIRECT_URL=
# Optional trusted CA for pg runtime/imports and Prisma migration commands.
DATABASE_SSL_CA_FILE=
# Disposable shadow database, never an existing Supabase project or live data.
SHADOW_DATABASE_URL=
# Freshly migrated disposable reference for read-only baseline comparison.
BASELINE_REFERENCE_URL=
# Optional integration suite: TWO fresh disposable Supabase environments.
# Never point these at the development/live database containing your data.
TEST_DATABASE_ACK=
TEST_DATABASE_URL=
TEST_DIRECT_URL=
TEST_BASELINE_DIRECT_URL=
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
