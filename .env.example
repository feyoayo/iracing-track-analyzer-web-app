# Browser-safe Supabase Auth settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only runtime connection; role must be allowed to SET ROLE anon/authenticated.
DATABASE_URL=
# Direct/session connection for explicit migration commands, never browser-exposed.
DIRECT_URL=
# Disposable shadow database, never an existing Supabase project or live data.
SHADOW_DATABASE_URL=
